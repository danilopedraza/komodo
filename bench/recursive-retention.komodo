# Repeatedly discard local recursive functions to expose captured-environment cycles.
let make(seed) :=
    let local(0) := seed
    let local(n) := local(n - 1)
    local

# Repeat the workload to spend more time executing per measured process.
for repetition in 0..50 do
    var total := 0
    for n in 0..5000 do
        let f := make(n)
        total := total + f(2)

    assert(total = 12497500)
