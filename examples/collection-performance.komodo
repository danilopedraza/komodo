from utils import (reduce, fold, filter, filterFirst, sum, prod, some, every, isPrefix, indexOf)
assert(reduce([], (a, b) -> a + b, 7) = 7)
assert(reduce([1, 2, 3], (a, b) -> a * 10 + b, 0) = 123)
assert(reduce({3, 1, 2}, (a, b) -> a * 10 + b, 0) = 123)
assert(fold([10, 3, 2], (a, b) -> a - b) = 5)
assert(sum([x for x in 0..10000]) = 49995000)
assert(sum({x for x in 0..10000}) = 49995000)
assert(prod([2, 3, 4]) = 24)
assert(filter([1, 2, 3, 4], x -> x % 2 = 0) = [2, 4])
assert(filter({1, 2, 3, 4}, x -> x % 2 = 0) = {2, 4})
assert(filterFirst([1, 2, 3, 2], x -> x /= 2) = [1, 3, 2])
assert(filterFirst([1, 3], x -> x /= 2) = [1, 3])
assert(some([], x -> true) = false)
assert(every({}, x -> false) = true)
let onlyFirst(x) :=
    assert(x = 0)
    true
let rejectFirst(x) :=
    assert(x = 0)
    false
assert(some(0..1000000000000000000000000, onlyFirst))
assert(!every(0..1000000000000000000000000, rejectFirst))
assert(isPrefix("é🙂", "é🙂abc"))
assert(!isPrefix("é🙂a", "é🙂"))
assert(isPrefix("", ""))
assert(indexOf([0, 1, 7, 2, 3], 3) = 4)
assert(indexOf([1, 2], 3) = ())
assert([0 | [1, 2]] = [0, 1, 2])
assert({0 | [1, 2, 1]} = {0, 1, 2})
assert({0 | {1, 2}} = {0, 1, 2})
assert([1, 2] * 3 = [1, 2, 1, 2, 1, 2])
assert([] * 1000000000000000000000 = [])
assert(9223372036854775807 + 1 = 9223372036854775808)
assert(-9223372036854775808 - 1 = -9223372036854775809)
assert(9223372036854775808 - 1 = 9223372036854775807)
assert([x for x in 9223372036854775806..9223372036854775810] = [9223372036854775806, 9223372036854775807, 9223372036854775808, 9223372036854775809])
