let map(iter: Set, fn: Function) := {fn(val) for val in iter}
let map(iter: List || Range || Generator, fn: Function) := [fn(val) for val in iter]

from collections import (reduce, filter, some, every, isPrefix)
from collections import (filterFirst)

let fold([first|most], fn: Function) := reduce(most, fn, first)
let fold({some|most}, fn: Function) := reduce(most, fn, some)

let deleteOnce(container, element) := filterFirst(container, val -> val /= element)

let sum(container) :=
    reduce(container, (a, b) -> a + b, 0)

let prod(container) :=
    reduce(container, (a, b) -> a * b, 1)

let indexOfHelper([] || "", _, _: Integer) := ()
let indexOfHelper([value|tail], value, acc: Integer) := acc
let indexOfHelper([_|tail], value, acc: Integer) := indexOfHelper(tail, value, acc + 1)

let indexOf(values: List, value) :=
    indexOfHelper(values, value, 0)

let inspect(obj) :=
    print(obj)
    obj

let inspect(obj, msg: String) :=
    print(msg + ": " + String(obj))
    obj
